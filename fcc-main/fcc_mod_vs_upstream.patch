+                    kind="terminal",
+                    group="windows_monitors",
+                    critical=False,
+                    check_command="htop",
+                    install_commands=[
+                        "Set-ExecutionPolicy Bypass -Scope Process -Force",
+                        "iwr https://community.chocolatey.org/install.ps1 -UseBasicParsing | iex",
+                        "choco install htop -y",
+                    ],
+                    update_commands=[
+                        "choco upgrade htop -y",
+                    ],
+                ),
+                DependencySpec(
+                    name="nmon",
+                    display_name="nmon (terminal monitor, Windows via Chocolatey)",
+                    kind="terminal",
+                    group="windows_monitors",
+                    critical=False,
+                    check_command="nmon",
+                    install_commands=[
+                        "Set-ExecutionPolicy Bypass -Scope Process -Force",
+                        "iwr https://community.chocolatey.org/install.ps1 -UseBasicParsing | iex",
+                        "choco install nmon -y",
+                    ],
+                    update_commands=[
+                        "choco upgrade nmon -y",
+                    ],
+                ),
+                DependencySpec(
+                    name="nom",
+                    display_name="nom (Node-based monitor, Windows)",
+                    kind="node",
+                    group="windows_monitors",
+                    critical=False,
+                    check_command="nom",
+                    install_commands=[
