+            "server": getattr(self, "server_port", None),
+            "claude": getattr(self, "claude_port", None),
+            "nemotron": getattr(self, "nemotron_port", None),
+        }.get(service)
+
+        if service_field:
+            return int(service_field)
+
+        # fallback to generic port
+        if getattr(self, "port", None):
+            return int(self.port)
+
+        fallback_map = {"server": 8082, "claude": 8083, "nemotron": 8084}
+        return int(fallback_map.get(service, 8083))
+
