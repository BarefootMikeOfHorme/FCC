-    _TPM_PREFIX
-    + rf"limit\s+([0-9]{{1,{_MAX_DECIMAL_DIGITS}}})(?![0-9])\s*,\s*"
-    + rf"requested\s+([0-9]{{1,{_MAX_DECIMAL_DIGITS}}})"
-    + r"(?=\s*(?:,(?!\s*[0-9])|$))",
-    re.IGNORECASE,
-)
-_OUTPUT_FIELDS = frozenset({"max_completion_tokens", "max_tokens"})
