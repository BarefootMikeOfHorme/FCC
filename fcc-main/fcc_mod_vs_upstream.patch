+        ("Hermes Agent v0.20.4 (2026-08-19)\n", 0, (0, 20, 4)),
+        ("0.21.0\n", 0, (0, 21, 0)),
+        ("Hermes Agent v0.20.3\n", 0, (0, 20, 3)),
