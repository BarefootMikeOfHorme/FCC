-
-        remainder = chunk[chunk_start:]
-        if remainder:
-            self._parts.append(remainder)
-        if chunk_start:
-            self._boundary_tail = remainder[-3:]
-        else:
-            self._boundary_tail = (self._boundary_tail + chunk)[-3:]
