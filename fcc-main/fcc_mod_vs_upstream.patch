+
+def _anthropic_stop_reason(reason: FinishReason) -> str:
+    return {
+        FinishReason.TOOL_CALLS: "tool_use",
+        FinishReason.OUTPUT_LIMIT: "max_tokens",
+        FinishReason.STOP_SEQUENCE: "stop_sequence",
+    }.get(reason, "end_turn")
