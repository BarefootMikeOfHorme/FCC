-def _terminal_event(
-    status: str,
-    *,
-    output: list[JsonObject] | None = None,
-    error: JsonObject | None = None,
-) -> str:
-    event_type = f"response.{status}"
-    incomplete_details: JsonObject | None = (
-        {"reason": "max_output_tokens"} if status == "incomplete" else None
