+    def get_service_host(self, service: Literal["server", "claude", "nemotron"] = "server") -> str:
+        """
+        Resolve host for a named service.
+
+        Priority:
+        1. Environment variable <SERVICE>_HOST (e.g., SERVER_HOST, CLAUDE_HOST)
+        2. This Settings.host attribute
+        3. Fallback "0.0.0.0"
+        """
+        import os
+
+        env = os.environ.get(f"{service.upper()}_HOST")
+        if env is not None and env != "":
+            return env
+        return getattr(self, "host", "0.0.0.0")
+
+    def get_service_port(self, service: Literal["server", "claude", "nemotron"] = "server") -> int:
+        """
+        Resolve port for a named service.
+
+        Priority:
+        1. Environment variable <SERVICE>_PORT (e.g., SERVER_PORT, CLAUDE_PORT)
+        2. Service-specific field on Settings (server_port, claude_port, nemotron_port)
+        3. Settings.port
+        4. Fallback defaults (server:8082, claude:8083, nemotron:8084)
+        """
+        import os
+
+        env = os.environ.get(f"{service.upper()}_PORT")
+        if env:
+            try:
+                return int(env)
+            except ValueError:
+                # ignore invalid env and fall back
+                pass
+
